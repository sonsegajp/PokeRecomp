Route124_DivingTreasureHuntersHouse_Text_19F64E:: @ 819F64E
	.string "Whoops, your BAG's full.\n"
	.string "Get rid of some items, friend!$"

Route124_DivingTreasureHuntersHouse_Text_19F686:: @ 819F686
