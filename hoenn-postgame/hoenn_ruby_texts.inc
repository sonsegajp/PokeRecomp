@ ===== OldaleTown =====
OldaleTown_Text_SavingMyProgress:: @ 816AEC0
	.string "I want to take a rest, so I'm saving my\n"
	.string "progress.$"

OldaleTown_Text_IWorkAtPokemonMart:: @ 816AEF2
	.string "Hi!\n"
	.string "I work at a POKeeMON MART.\p"
	.string "Can I get you to come with me?$"

OldaleTown_Text_ThisIsAPokemonMart:: @ 816AF2F
	.string "This is a POKeeMON MART.\n"
	.string "Just look for our blue roof.\p"
	.string "We sell a variety of goods including\n"
	.string "POKee BALLS for catching POKeeMON.\p"
	.string "Here, I'd like you to have this as a\n"
	.string "promotional item.$"

OldaleTown_Text_PotionExplanation:: @ 816AFE1
	.string "A POTION can be used anytime, so it's\n"
	.string "even more useful than a POKeeMON CENTER\l"
	.string "in certain situations.$"

OldaleTown_Text_WaitDontComeInHere:: @ 816B045
	.string "Aaaaah! Wait!\n"
	.string "Please don't come in here.\p"
	.string "I just discovered the footprints of\n"
	.string "a rare POKeeMON!\p"
	.string "Wait until I finish sketching\n"
	.string "them, okay?$"

OldaleTown_Text_DiscoveredFootprints:: @ 816B0CC
	.string "I just discovered the footprints of\n"
	.string "a rare POKeeMON!\p"
	.string "Wait until I finish sketching\n"
	.string "them, okay?$"

OldaleTown_Text_FinishedSketchingFootprints:: @ 816B12A
	.string "I finished sketching the footprints of\n"
	.string "a rare POKeeMON.\p"
	.string "But it turns out they were only my\n"
	.string "own footprints...$"

OldaleTown_Text_MayLetsGoBack:: @ 816B196
	.string "MAY: {PLAYER}{KUN}!\n"
	.string "Over here!\l"
	.string "Let's hurry home!$"

OldaleTown_Text_BrendanLetsGoBack:: @ 816B1BE
	.string "BRENDAN: I'm heading back to my dad's\n"
	.string "LAB now.\l"
	.string "{PLAYER}, you should hustle back, too.$"

OldaleTown_Text_TownSign:: @ 816B20E
	.string "OLDALE TOWN\n"
	.string "eeeWhere things start off scarce.eee$"


@ ===== OldaleTown_House1 =====
OldaleTown_House1_Text_LeftPokemonGoesOutFirst:: @ 817476D
	.string "When a POKeeMON battle starts, the one\n"
	.string "at the left of the list goes out first.\p"
	.string "So, when you get more POKeeMON in your\n"
	.string "party, try switching around the order\l"
	.string "of your POKeeMON.\p"
	.string "It could give you an advantage.$"


@ ===== OldaleTown_House2 =====
OldaleTown_House2_Text_PokemonLevelUp:: @ 8174838
	.string "When POKeeMON battle, they eventually\n"
	.string "level up and become stronger.$"

OldaleTown_House2_Text_YoullGoFurtherWithStrongPokemon:: @ 817487B
	.string "If the POKeeMON with you become\n"
	.string "stronger, you'll be able to go farther\l"
	.string "away from here.$"


@ ===== OldaleTown_Mart =====
OldaleTown_Mart_Text_PokeBallsAreSoldOut:: @ 8174A8A
	.string "The clerk says they're all sold out.\n"
	.string "I can't buy any POKee BALLS.$"

OldaleTown_Mart_Text_ImGoingToBuyPokeBalls:: @ 8174ACB
	.string "I'm going to buy a bunch of POKee BALLS\n"
	.string "and catch a bunch of POKeeMON!$"

OldaleTown_Mart_Text_RestoreHPWithPotion:: @ 8174B10
	.string "If a POKeeMON gets hurt and loses its HP\n"
	.string "and faints, it won't be able to battle.\p"
	.string "To prevent your POKeeMON from fainting,\n"
	.string "restore its HP with a POTION.$"


@ ===== OldaleTown_PokemonCenter_1F =====
OldaleTown_PokemonCenter_1F_Text_TrainersCanUsePC:: @ 81748D1
	.string "That PC in the corner there is\n"
	.string "for any POKeeMON TRAINER to use.\p"
	.string "Naturally, that means you're welcome\n"
	.string "to use it, too.$"

OldaleTown_PokemonCenter_1F_Text_PokemonCentersAreGreat:: @ 8174945
	.string "POKeeMON CENTERS are great!\p"
	.string "You can use their services as much\n"
	.string "as you like, and it's all for free.\l"
	.string "You never have to worry!$"

OldaleTown_PokemonCenter_1F_Text_CableClubNotAvailable:: @ 81749C0
	.string "The POKeeMON CABLE CLUB on the second\n"
	.string "floor was built recently.\p"
	.string "But they say they're still making\n"
	.string "adjustments.$"

OldaleTown_PokemonCenter_1F_Text_TradedInCableClub:: @ 8174A2E
	.string "The POKeeMON CABLE CLUB on the second\n"
	.string "floor was built recently.\p"
	.string "I traded POKeeMON right away.$"


@ ===== PacifidlogTown =====
