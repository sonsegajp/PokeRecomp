	.string "TRAINER.$"

PacifidlogTown_House2_Text_Rururi:: @ 81793CC
	.string "AZURILL: Rururi!$"

PacifidlogTown_House2_Text_DoesntLikeTrainerVeryMuch:: @ 81793DD
	.string "It doesn't appear to like the TRAINER\n"
	.string "very much.$"


@ ===== PacifidlogTown_House3 =====
PacifidlogTown_House3_Text_WillingToTradeIt:: @ 817940E
	.string "Hello, TRAINER. Would you do me a favor\n"
	.string "and trade POKeeMON with me?\p"
	.string "Living in PACIFIDLOG, I can only catch\n"
	.string "certain kinds of POKeeMON.\p"
	.string "{STR_VAR_1}? Do you have one?\n"
	.string "I'll trade you my {STR_VAR_2} for it.$"

PacifidlogTown_House3_Text_MonIsSoFluffy:: @ 81794C4
	.string "Wow!\n"
	.string "This {STR_VAR_1} is so fluffy!$"

PacifidlogTown_House3_Text_ThatsNoMon:: @ 81794DF
	.string "That's no {STR_VAR_1}.$"

PacifidlogTown_House3_Text_ImDisappointed:: @ 81794ED
	.string "I'm a little disappointed...$"

PacifidlogTown_House3_Text_NowWereFriends:: @ 817950A
	.string "Since we traded, you and me,\n"
	.string "we're friends, aren't we?$"

PacifidlogTown_House3_Text_IsThatAPokedex:: @ 8179541
	.string "Is that a POKeeDEX?\p"
	.string "Did you get to meet a lot of different\n"
	.string "POKeeMON?\p"
	.string "I wish I was like you.$"


@ ===== PacifidlogTown_House4 =====
PacifidlogTown_House4_Text_PeopleSawHighFlyingPokemon:: @ 817959B
	.string "People were saying they saw a POKeeMON\n"
	.string "FLYING high above HOENN.\p"
	.string "Is it FLYING around all the time?\n"
	.string "Doesn't it need to rest somewhere?$"

PacifidlogTown_House4_Text_SkyPokemon:: @ 817961F
	.string "A sky POKeeMON!\n"
	.string "A sky POKeeMON!$"

PacifidlogTown_House4_Text_WhereDidYouComeFrom:: @ 817963D
	.string "Where did you come from?$"

PacifidlogTown_House4_Text_YesTown:: @ 8179656
