Route124_DivingTreasureHuntersHouse_Text_19F5E0:: @ 819F5E0
	.string "You'll trade your {STR_VAR_1} for\n"
	.string "my {STR_VAR_2}, then?$"

Route124_DivingTreasureHuntersHouse_Text_19F606:: @ 819F606
