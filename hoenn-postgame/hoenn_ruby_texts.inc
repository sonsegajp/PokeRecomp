	.string "I'll give you a TM that's suitable for\l"
	.string "your POKeeMON.$"

PacifidlogTown_House2_Text_Rurii:: @ 817938B
	.string "AZURILL: Rurii.$"

PacifidlogTown_House2_Text_VeryFriendlyWithTrainer:: @ 817939B
