# Files that must be compiled at -O0 to prevent stale pointer guard optimization
# (Pokemon Center transitions crash with -O3 due to quest log stale heap pointers)
O0_FILES := event_object_movement overworld quest_log quest_log_battle \
            quest_log_events quest_log_objects quest_log_player \
            field_screen_effect field_fadetransition field_control_avatar

define O0_RULE
$(C_BUILDDIR)/$(1).o : $(C_SUBDIR)/$(1).c $$(c_dep)
	@$$(CPP) $$(CPPFLAGS) $$< -o $(C_BUILDDIR)/$(1).i
	@$$(PREPROC) $(C_BUILDDIR)/$(1).i charmap.txt | $$(CC1) $$(CFLAGS) -O0 -o $(C_BUILDDIR)/$(1).s
	@echo -e ".text\n\t.align\t2, 0\n" >> $(C_BUILDDIR)/$(1).s
	$$(AS) $$(ASFLAGS) -o $$@ $(C_BUILDDIR)/$(1).s
endef
$(foreach f,$(O0_FILES),$(eval $(call O0_RULE,$(f))))

$(C_BUILDDIR)/music_player_port.o : $(C_SUBDIR)/music_player_port.c $$(c_dep)
	@$(CPP) $(CPPFLAGS) $< -o $(C_BUILDDIR)/music_player_port.i
	@$(PREPROC) $(C_BUILDDIR)/music_player_port.i charmap.txt | $(CC1) $(CFLAGS) -O0 -o $(C_BUILDDIR)/music_player_port.s
	@echo -e ".text\n\t.align\t2, 0\n" >> $(C_BUILDDIR)/music_player_port.s
	$(AS) $(ASFLAGS) -o $@ $(C_BUILDDIR)/music_player_port.s

$(C_BUILDDIR)/m4a.o : $(C_SUBDIR)/m4a.c $$(c_dep)
	@$(CPP) $(CPPFLAGS) $< -o $(C_BUILDDIR)/m4a.i
	@$(PREPROC) $(C_BUILDDIR)/m4a.i charmap.txt | $(CC1) $(CFLAGS) -O0 -o $(C_BUILDDIR)/m4a.s
	@echo -e ".text\n\t.align\t2, 0\n" >> $(C_BUILDDIR)/m4a.s
	$(AS) $(ASFLAGS) -o $@ $(C_BUILDDIR)/m4a.s

$(C_BUILDDIR)/%.o : $(C_SUBDIR)/%.c $$(c_dep)
	@$(CPP) $(CPPFLAGS) $< -o $(C_BUILDDIR)/$*.i
	@$(PREPROC) $(C_BUILDDIR)/$*.i charmap.txt | $(CC1) $(CFLAGS) -o $(C_BUILDDIR)/$*.s
	@echo -e ".text\n\t.align\t2, 0\n" >> $(C_BUILDDIR)/$*.s
	@sed -i 's/\r$$//' $(C_BUILDDIR)/$*.s
	$(AS) $(ASFLAGS) -o $@ $(C_BUILDDIR)/$*.s

ifeq ($(NODEP),1)
$(GFLIB_BUILDDIR)/%.o: c_dep :=
else
$(GFLIB_BUILDDIR)/%.o: c_dep = $(shell [[ -f $(GFLIB_SUBDIR)/$*.c ]] && $(SCANINC) -I include -I $(TOOLS_DIR)/agbcc/include -I gflib $(GFLIB_SUBDIR)/$*.c)
endif

$(GFLIB_BUILDDIR)/%.o : $(GFLIB_SUBDIR)/%.c $$(c_dep)
	@$(CPP) $(CPPFLAGS) $< -o $(GFLIB_BUILDDIR)/$*.i
	@$(PREPROC) $(GFLIB_BUILDDIR)/$*.i charmap.txt | $(CC1) $(CFLAGS) -o $(GFLIB_BUILDDIR)/$*.s
	@echo -e ".text\n\t.align\t2, 0\n" >> $(GFLIB_BUILDDIR)/$*.s
	$(AS) $(ASFLAGS) -o $@ $(GFLIB_BUILDDIR)/$*.s

# The dep rules have to be explicit or else missing files won't be reported.
# As a side effect, they're evaluated immediately instead of when the rule is invoked.
# It doesn't look like $(shell) can be deferred so there might not be a better way.


ifeq ($(NODEP),1)
$(ASM_BUILDDIR)/%.o: $(ASM_SUBDIR)/%.s
	$(AS) $(ASFLAGS) -o $@ $<
	$(FIX_UNDERSCORE) $@
else
define ASM_DEP
$1: $2 $$(shell $(SCANINC) -I include -I "" $2)
	$$(AS) $$(ASFLAGS) -o $$@ $$<
	$(FIX_UNDERSCORE) $$@
endef
$(foreach src, $(ASM_SRCS), $(eval $(call ASM_DEP,$(patsubst $(ASM_SUBDIR)/%.s,$(ASM_BUILDDIR)/%.o, $(src)),$(src))))
endif

ifeq ($(NODEP),1)
$(DATA_ASM_BUILDDIR)/%.o: $(DATA_ASM_SUBDIR)/%.s
	$(PREPROC) $< charmap.txt | $(CPP) -xc -I include - | $(PREPROC) -ie $$< charmap.txt | $(ASM_PSEUDO_OP_CONV) | $(WRAP_MACRO_ARGS) | $(AS) $(ASFLAGS) -o $@
	$(FIX_UNDERSCORE) $@
else
define DATA_ASM_DEP
$1: $2 $$(shell $(SCANINC) -I include -I "" $2)
	$$(PREPROC) $$< charmap.txt | $$(CPP) -xc -I include - | $$(PREPROC) -ie $$< charmap.txt | $$(ASM_PSEUDO_OP_CONV) | $$(WRAP_MACRO_ARGS) | $$(AS) $$(ASFLAGS) -o $$@
	$$(FIX_UNDERSCORE) $$@
endef
$(foreach src, $(REGULAR_DATA_ASM_SRCS), $(eval $(call DATA_ASM_DEP,$(patsubst $(DATA_ASM_SUBDIR)/%.s,$(DATA_ASM_BUILDDIR)/%.o, $(src)),$(src))))
$(foreach src, $(C_ASM_SRCS), $(eval $(call DATA_ASM_DEP,$(patsubst $(C_SUBDIR)/%.s,$(C_BUILDDIR)/%.o, $(src)),$(src))))
endif

$(SONG_BUILDDIR)/%.o: $(SONG_SUBDIR)/%.s
