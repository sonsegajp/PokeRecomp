PREFIX := i686-w64-mingw32-
# MSYS2's mingw-w64-i686 toolchain only ships prefixed wrappers for gcc/cc/g++/etc.
# binutils (as, ld, objcopy, objdump) come unprefixed in /mingw32/bin/, so we use those.
OBJCOPY := objcopy
CC := $(PREFIX)gcc
CXX := $(PREFIX)g++
AS := as

SDL_DIR := /c/msys64/mingw32
ASM_PSEUDO_OP_CONV := sed -e 's/\.4byte/\.int/g;s/\.2byte/\.short/g' -e 's/^[[:space:]]*\.word\b/\t.int/' -e 's/^[[:space:]]*\.section[[:space:]].*%progbits.*$$/\t.data/' -e 's/^[[:space:]]*\.size[[:space:]].*$$//' -e 's/\\@/__MACRO_CTR__/g' -e 's/@.*//' -e 's/__MACRO_CTR__/\\@/g'
# Post-CPP fixup: wrap macro-call args with top-level operators in extra parens
# so x86 GAS's macro arg parser doesn't split `(a+b)-c` into two args.
WRAP_MACRO_ARGS := python tools/wrap_macro_args.py
#FIX_UNDERSCORE is required for 32 bit windows
FIX_UNDERSCORE := $(OBJCOPY) --prefix-symbol _

export CPP := $(PREFIX)gcc -E
export LD := ld

