override CFLAGS += -Wno-trigraphs -Wimplicit -Wparentheses -Wunused -m32 -msse2 -mfxsr -std=gnu23 -fleading-underscore -fno-dce -fno-builtin -Wno-unused-function -Wno-error=int-conversion -Wno-error=incompatible-pointer-types -Wno-error=discarded-qualifiers -Wno-int-conversion -Wno-discarded-qualifiers -DPORTABLE -DNONMATCHING -D UBFIX -DMODERN=$(MODERN)
